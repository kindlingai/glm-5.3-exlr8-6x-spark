# GLM-5.3 on six DGX Sparks (1M context). Copy to .env next to compose.yaml on every box: the
# same file on all six. Compose passes each line into the container, where gr8's launcher reads it as an option
# (`docker compose exec gr8 /opt/gr8/gr8 knobs` lists every option).
#
# Set PEERS. Leave the rest as it is: every line under "1M context" below is a setting of the measured serve.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=glm53
# The release, pinned to the Hugging Face commit the README's numbers were measured with. The model cache is keyed
# by commit, so a new commit on the repo changes nothing here until this line moves.
MODEL=https://huggingface.co/kindlingai/glm-5.3-exlr8-k2-k3-k4@a36ae4680871ffa6412061d5daf66c4d4ad5802c
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- the boxes -------------------------------------------------------------------------------------------------------
# The LAN address of each of the six boxes, in rank order, the same line on every box. The first is the head
# (OpenAI API on port 8100). The boxes are on a switch (SHAPE=mesh): a ring needs TP=3 or 4.
PEERS=192.0.2.1,192.0.2.2,192.0.2.3,192.0.2.4,192.0.2.5,192.0.2.6
TP=6
SHAPE=mesh

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# A host directory for this box's part of the model, owned by uid 1000. Unset, a named volume.
#GR8_CACHE=/srv/gr8/cache
# A host directory for logs and state, owned by uid 1000.
#GR8_HOME=/srv/gr8/home

# --- 1M context: the settings of the measured serve ------------------------------------------------------------------
# int4 KV: CAP 1048576 = 16384 pages of 64 tokens (max_model_len 1048570, the full context of the model).
# SHARE_LIMIT 131072: README.md says why.
KV_FORMAT=int4
KV4_FOLD=1
KV4_TC=1
CAP=1048576
# Roll back to fp8 KV (max_model_len 612986): uncomment the four lines below.
# (The fp8 engine does not read the GR8_KV4_* entries in EXTRA_ENV.)
#KV_FORMAT=fp8
#KV4_FOLD=0
#KV4_TC=0
#CAP=612992
PROXY_CPU=19
S2PORT=7341
MTP=3
DFLASH=0
SPEC_ACCEPT=rejection
SESS=4
SHARE_LIMIT=131072
NOHASH=0
READY_TMO=600
KVB=bf16
EXTRA_ENV="GR8_L2PF=31 GR8_K1_SPLIT=1:/4,2-3:2x1,4-32:8x1/4 GR8_K1_TLBW=2048 GR8_CP_STEP_ROWS=8 GR8_MTP_KSTOPB=1 GR8_MTP_LPLOG=1 GR8_MTP_KSTOPB_TAU_S2=0.7,0.8,0.9 GR8_MTP_KSTOPB_TAU_S3=0.7,0.88,0.95 GR8_MTP_KSTOPB_TAU_S4=0.7,0.75,0.9 GR8_KV4_SC=4 GR8_KV4_SC_TR=2 GR8_KV4_QT=1 GR8_KV4_CTX=2 GR8_KV4_FUSE_ROT=1"
PF_GEMMF32=1
QA_SPLIT=1
IDXQ_SPLIT=1
MTP_SPLIT=1
ROUTE_OVL=1
ATTN_SC2=4
ATTN_SC2_TR=2
ATTN_CTX2=4
ATTN_CTX3=2
ATTN_SEL2=16
IDX_GRP=16
ATTN_QT=1
ATTN_FRONT=1
MTP_LASTROW=1
DRAFT_HEAD_I4=1
DRAFT_HEAD2=1
ATTN_POSIDX=1
MTP_KSTOP=1
MTP_KSTOP_KMAX=3
MTP_KSTOP_TAU=0,0.5,0.75
MTP_KSTOPB_WIDTHS=2,3,5,6,7,9,10,11,13,14,15
MTP_L2PF=3
